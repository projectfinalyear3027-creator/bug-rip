# =============================================================================
# BUG RIP: Execution Worker Service Container
# Consumes jobs from Redis/BullMQ and orchestrates isolated Java runners
# =============================================================================
FROM node:22-alpine

WORKDIR /worker

RUN apk add --no-cache docker-cli

COPY package*.json ./
RUN npm ci --omit=dev

COPY execution-worker/ ./execution-worker/
COPY backend/ ./backend/

ENV NODE_ENV=production

CMD ["node", "execution-worker/worker.js"]
