# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =============================================================================
# BUG SNIPER: Production Environment Configuration
# =============================================================================

# Server Environment
PORT=3000
NODE_ENV=production

# Database Configuration (PostgreSQL is MANDATORY in production)
# Example: postgresql://bugrip_user:StrongPassword2026@127.0.0.1:5432/bugrip_db
DATABASE_URL=postgresql://bugrip_user:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/bugrip_db

# Queue Configuration (Redis is MANDATORY in production)
# Example: redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# Queue Name (Must match producer and worker)
EXECUTION_QUEUE_NAME=java-execution

# Force in-memory queue (DEV ONLY - strictly forbidden in production)
# EXECUTION_IN_MEMORY=false

# Admin API Key / Secret Header (Must be secure, >= 16 characters in production)
ADMIN_SECRET_KEY=YOUR_SECURE_ADMIN_SECRET_KEY_AT_LEAST_16_CHARS

# Initial Admin Password (Required on fresh production startup; must be strong, >= 10 chars)
ADMIN_INITIAL_PASSWORD=YOUR_STRONG_INITIAL_ADMIN_PASSWORD_MIN_10_CHARS

# CORS and Application URL (Production restricts origin to this URL)
# CORS_ORIGIN=https://bugsniper.yourdomain.com
# APP_URL=https://bugsniper.yourdomain.com

# Competition Configuration (Solo individual competition)
COMPETITION_DURATION_MINUTES=60
MIN_TEAM_MEMBERS=1
MAX_TEAM_MEMBERS=1

# Java Environment (Optional: auto-detected from system OpenJDK 21)
# JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64


